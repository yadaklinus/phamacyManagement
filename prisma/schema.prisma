// School Clinic Drug Tracking System
// Focus: Complete drug tracking from purchase to administration
// Admin oversight for theft prevention

generator client {
  provider = "prisma-client-js"
  output   = "generated/offline"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum role {
  admin
  physician
  pharmacist
}

enum unit {
  tablet
  capsule
  bottle
  sachet
  injection
  tube
  ml
  mg
  piece
}

enum movementType {
  PURCHASE          // Drug bought from supplier
  ADMINISTERED      // Drug given to student
  ADJUSTMENT        // Manual stock correction
  EXPIRED           // Drug expired and removed
  DAMAGED           // Drug damaged
  RETURNED          // Student returned unused
  LOSS              // Missing/stolen
}

enum alertType {
  low_stock
  out_of_stock
  expiring_soon
  expired
  unusual_activity
  discrepancy
}

// ==================== USERS ====================

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  password     String
  role         role
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  @@index([email])
  @@index([role])
}

model Settings {
  id                      String    @id @default(uuid())
  schoolName              String
  clinicName              String
  email                   String
  phone                   String
  address                 String
  logoUrl                 String?
  
  // Alert Settings
  alertEmail              String
  alertPhone              String?
  lowStockThreshold       Int       @default(20) // Percentage
  enableStockAlerts       Boolean   @default(true)
  enableActivityAlerts    Boolean   @default(true)
  
  // Security Settings
  requireApprovalForAdjustment Boolean @default(true)
  maxDrugsPerConsultation      Int     @default(10)
  
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

// ==================== STUDENTS ====================

model Student {
  id                  String          @id @default(uuid())
  matricNumber        String          @unique
  name                String
  email               String?
  phone               String
  department          String
  level               String          // 100, 200, 300, etc.
  faculty             String
  dateOfBirth         DateTime
  gender              String
  bloodGroup          String?
  genotype            String?
  allergies           String?         // Comma-separated or JSON
  chronicConditions   String?         // Comma-separated or JSON
  emergencyContact    String
  emergencyPhone      String
  profilePhoto        String?
  isActive            Boolean         @default(true)
  
  // Relations
  consultations       Consultation[]
  drugRecords         DrugRecord[]
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([matricNumber])
  @@index([department])
  @@index([isActive])
}

// ==================== PHYSICIANS ====================

model Physician {
  id                  String          @id @default(uuid())
  staffId             String          @unique
  name                String
  email               String
  phone               String
  specialization      String?
  qualification       String?
  isActive            Boolean         @default(true)
  
  // Relations
  consultations       Consultation[]
  drugRecords         DrugRecord[]    // Drugs they administered
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([staffId])
  @@index([isActive])
}

// ==================== CONSULTATIONS ====================

model Consultation {
  id              String          @id @default(uuid())
  consultationNo  String          @unique
  
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id])
  
  physicianId     String
  physician       Physician       @relation(fields: [physicianId], references: [id])
  
  // Medical Details
  complaint       String          // Chief complaint
  diagnosis       String          // Diagnosis
  vitals          String?         // JSON: { temp, bp, pulse, weight }
  symptoms        String?         // JSON array of symptoms
  notes           String?
  
  // Relations
  drugRecords     DrugRecord[]    // Drugs administered during this visit
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  @@index([studentId, createdAt])
  @@index([physicianId, createdAt])
  @@index([createdAt])
}

// ==================== DRUG RECORDS (Main Tracking) ⭐⭐⭐ ====================
// Every drug given to a student creates ONE record here
// This is the core of the tracking system

model DrugRecord {
  id                  String        @id @default(uuid())
  recordNo            String        @unique // DR-2025-0001
  
  // WHO received the drug
  studentId           String
  student             Student       @relation(fields: [studentId], references: [id])
  
  // WHO gave the drug
  physicianId         String
  physician           Physician     @relation(fields: [physicianId], references: [id])
  physicianName       String        // Cached for quick display
  
  // WHY they got it
  consultationId      String
  consultation        Consultation  @relation(fields: [consultationId], references: [id])
  diagnosis           String        // Copied for audit trail
  
  // WHAT drug
  drugId              String
  drug                Drug          @relation(fields: [drugId], references: [id])
  drugName            String        // Cached for audit trail
  
  // HOW MUCH
  quantity            Int
  unit                String
  dosage              String?       // e.g., "500mg"
  frequency           String?       // e.g., "3 times daily"
  duration            String?       // e.g., "5 days"
  instructions        String?       // How to take it
  
  // WHEN
  administeredAt      DateTime      @default(now())
  
  // TRACKING (Critical for theft prevention)
  batchNumber         String?
  expiryDate          DateTime?
  stockBefore         Int           // Stock before giving
  stockAfter          Int           // Stock after giving
  unitCost            Float?        // Cost per unit
  totalCost           Float?        // Total cost
  
  createdAt           DateTime      @default(now())
  
  @@index([studentId, administeredAt])
  @@index([drugId, administeredAt])
  @@index([physicianId, administeredAt])
  @@index([consultationId])
  @@index([administeredAt])
  @@index([batchNumber])
}

// ==================== DRUGS (Inventory) ====================

model Drug {
  id                  String              @id @default(uuid())
  drugCode            String              @unique // Internal code: DRG-001
  name                String
  genericName         String?
  brandName           String?
  category            String              // Painkiller, Antibiotic, etc.
  manufacturer        String?
  
  // Stock Management
  currentStock        Int                 @default(0)
  reorderLevel        Int                 @default(50)
  maxStockLevel       Int?
  
  // Pricing
  averageCost         Float               @default(0)
  currentUnitPrice    Float               @default(0)
  
  unit                unit
  description         String?
  
  // Drug Properties
  dosageForm          String?             // Tablet, Syrup, Injection
  strength            String?             // 500mg, 250mg/5ml
  requiresPrescription Boolean            @default(true)
  storageConditions   String?
  
  // Lifetime Tracking
  totalPurchased      Int                 @default(0)
  totalAdministered   Int                 @default(0)
  totalAdjustments    Int                 @default(0)
  
  // Status
  isActive            Boolean             @default(true)
  
  // Relations
  drugRecords         DrugRecord[]
  purchaseItems       PurchaseItem[]
  drugMovements       DrugMovement[]
  batches             DrugBatch[]
  alerts              Alert[]
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  @@index([drugCode])
  @@index([category])
  @@index([currentStock])
  @@index([isActive])
}

// ==================== DRUG BATCHES ====================

model DrugBatch {
  id                  String        @id @default(uuid())
  batchNumber         String        @unique
  
  drugId              String
  drug                Drug          @relation(fields: [drugId], references: [id])
  
  // Batch Details
  manufactureDate     DateTime?
  expiryDate          DateTime
  supplier            String
  
  // Quantity Tracking
  initialQuantity     Int
  currentQuantity     Int
  administeredQuantity Int          @default(0)
  
  // Cost
  unitCost            Float
  totalCost           Float
  
  // Status
  isExpired           Boolean       @default(false)
  
  // Tracking
  receivedDate        DateTime      @default(now())
  receivedBy          String        // User name
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  @@index([drugId, expiryDate])
  @@index([batchNumber])
  @@index([expiryDate])
}

// ==================== DRUG MOVEMENTS (Complete Audit Trail) ⭐⭐⭐ ====================
// Every stock change creates a record here
// This is how admin tracks everything

model DrugMovement {
  id                  String          @id @default(uuid())
  movementNo          String          @unique // MOV-2025-0001
  
  // WHAT drug moved
  drugId              String
  drug                Drug            @relation(fields: [drugId], references: [id])
  drugName            String          // Cached for quick display
  
  // TYPE of movement
  movementType        movementType
  
  // HOW MUCH moved
  quantity            Int             // Can be negative for administration
  unit                String
  
  // STOCK TRACKING (Before & After)
  stockBefore         Int
  stockAfter          Int
  
  // VALUE
  unitCost            Float?
  totalValue          Float?
  
  // WHY it moved
  reason              String
  notes               String?
  
  // REFERENCE to source record
  referenceType       String?         // "consultation", "purchase", "adjustment"
  referenceNo         String?         // Consultation no, Purchase no, etc.
  
  // WHO performed the movement
  performedBy         String          // User name
  performedById       String          // User ID
  
  // WHEN
  performedAt         DateTime        @default(now())
  
  // Approval (for adjustments)
  requiresApproval    Boolean         @default(false)
  approvedBy          String?
  approvedAt          DateTime?
  approvalStatus      String?         // pending, approved, rejected
  
  createdAt           DateTime        @default(now())
  
  @@index([drugId, performedAt])
  @@index([movementType])
  @@index([performedBy])
  @@index([performedAt])
  @@index([referenceType, referenceNo])
}

// ==================== PURCHASES ====================

model Purchase {
  id                  String          @id @default(uuid())
  purchaseOrderNo     String          @unique 
  
  supplier            String
  supplierContact     String?
  
  // Items
  purchaseItems       PurchaseItem[]
  
  // Financials
  subTotal            Float
  taxAmount           Float           @default(0)
  discount            Float           @default(0)
  totalAmount         Float
  
  // Status
  status              String          @default("completed") // pending, completed, cancelled
  
  // Dates
  purchaseDate        DateTime        @default(now())
  deliveryDate        DateTime?
  
  // People
  purchasedBy         String          // User name
  purchasedById       String          // User ID
  receivedBy          String?
  
  invoiceNumber       String?
  invoiceDocument     String?         // File path
  notes               String?
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  
  @@index([purchaseOrderNo])
  @@index([supplier])
  @@index([purchaseDate])
  @@index([status])
}

model PurchaseItem {
  id                  String          @id @default(uuid())
  
  purchaseId          String
  purchase            Purchase        @relation(fields: [purchaseId], references: [id])
  
  drugId              String
  drug                Drug            @relation(fields: [drugId], references: [id])
  
  drugName            String          // Cached
  batchNumber         String?
  expiryDate          DateTime?
  
  quantityOrdered     Int
  quantityReceived    Int
  
  unitCost            Float
  totalCost           Float
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([purchaseId])
  @@index([drugId])
}

// ==================== SUPPLIERS ====================

model Supplier {
  id                  String          @id @default(uuid())
  supplierCode        String          @unique
  name                String
  contactPerson       String?
  email               String
  phone               String
  address             String
  
  // Performance Tracking
  totalPurchases      Int             @default(0)
  totalValue          Float           @default(0)
  reliabilityRating   Float?          // 0-5 stars
  
  isActive            Boolean         @default(true)
  notes               String?
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([supplierCode])
  @@index([isActive])
}

// ==================== ALERTS & NOTIFICATIONS ====================

model Alert {
  id                  String          @id @default(uuid())
  
  alertType           alertType
  severity            String          // info, warning, critical
  
  title               String
  message             String
  
  // Context
  drugId              String?
  drug                Drug?           @relation(fields: [drugId], references: [id])
  
  relatedEntity       String?         // student_id, physician_id, etc.
  relatedEntityType   String?         // "student", "physician", "drug"
  
  // Details
  currentStock        Int?
  reorderLevel        Int?
  expiryDate          DateTime?
  
  // Status
  isResolved          Boolean         @default(false)
  resolvedBy          String?
  resolvedAt          DateTime?
  resolutionNotes     String?
  
  // Notification
  notifiedUsers       String?         // JSON array of user IDs
  notifiedAt          DateTime?
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([alertType, isResolved])
  @@index([severity, isResolved])
  @@index([createdAt])
  @@index([drugId])
}

// ==================== STOCK AUDIT (Reconciliation) ====================

model StockAudit {
  id                  String            @id @default(uuid())
  auditNo             String            @unique // AUDIT-2025-001
  
  auditDate           DateTime          @default(now())
  auditType           String            @default("full") // full, spot, random
  
  // Who performed it
  auditedBy           String            // User name
  auditedById         String            // User ID
  verifiedBy          String?           // Second checker
  
  // Results
  totalDrugs          Int
  totalDiscrepancies  Int
  totalValueDiscrepancy Float
  
  status              String            @default("in_progress") // in_progress, completed
  
  findings            String?           // JSON summary
  recommendations     String?
  
  // Items
  auditItems          StockAuditItem[]
  
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  
  @@index([auditNo])
  @@index([auditDate])
  @@index([status])
}

model StockAuditItem {
  id                  String          @id @default(uuid())
  
  auditId             String
  audit               StockAudit      @relation(fields: [auditId], references: [id])
  
  drugId              String
  drugName            String
  batchNumber         String?
  
  // Comparison
  systemStock         Int             // What system says
  physicalStock       Int             // What was counted
  discrepancy         Int             // Difference
  discrepancyValue    Float?          // Financial impact
  
  // Investigation
  possibleCause       String?
  actionTaken         String?
  notes               String?
  
  createdAt           DateTime        @default(now())
  
  @@index([auditId])
  @@index([drugId])
  @@index([discrepancy])
}

// ==================== ACTIVITY LOGS (Complete Audit Trail) ====================

model ActivityLog {
  id                  String          @id @default(uuid())
  
  // WHO did it
  userId              String
  userName            String
  userRole            String
  
  // WHAT they did
  action              String          // "created", "updated", "deleted", etc.
  entity              String          // "drug", "consultation", "purchase"
  entityId            String?
  
  description         String          // Human-readable
  
  // Details
  oldValue            String?         // JSON - before change
  newValue            String?         // JSON - after change
  
  // Context
  ipAddress           String?
  userAgent           String?
  
  createdAt           DateTime        @default(now())
  
  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action])
  @@index([createdAt])
}

// ==================== SYSTEM NOTIFICATIONS ====================

model Notification {
  id                  String          @id @default(uuid())
  
  recipientId         String          // User ID
  recipientRole       String?         // admin, physician, etc.
  
  type                String          // drug_administered, low_stock, etc.
  title               String
  message             String
  
  priority            String          @default("normal") // low, normal, high, urgent
  
  // Context
  relatedEntity       String?         // drug_id, consultation_id, etc.
  relatedEntityType   String?
  
  // Status
  isRead              Boolean         @default(false)
  readAt              DateTime?
  
  // Actions
  actionUrl           String?         // Link to relevant page
  actionText          String?         // Button text
  
  createdAt           DateTime        @default(now())
  
  @@index([recipientId, isRead])
  @@index([recipientRole, isRead])
  @@index([createdAt])
  @@index([type])
}